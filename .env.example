DB_HOST=127.0.0.1
DB_PORT=3310
DB_NAME=sav_ticketing
DB_USER=root
DB_PASSWORD=root
APP_ENV=local
APP_URL=http://localhost:8090
# Envoi des emails : "log" (dev, ecrit dans var/mail.log) ou "resend" (envoi reel).
MAIL_DRIVER=log
# Expediteur : sans domaine verifie chez Resend, seul onboarding@resend.dev
# est autorise, et uniquement vers l'email du compte Resend.
MAIL_FROM=SAV Ticketing <onboarding@resend.dev>
# Cle API Resend (https://resend.com/api-keys), uniquement dans .env, jamais commitee.
RESEND_API_KEY=
