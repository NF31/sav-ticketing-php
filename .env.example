DB_HOST=127.0.0.1
DB_PORT=3310
DB_NAME=sav_ticketing
DB_USER=root
DB_PASSWORD=root
APP_ENV=local
APP_URL=http://localhost:8090
# Envoi des emails (memes noms de variables que Laravel) : "log" (dev, ecrit
# dans var/mail.log) ou "resend" (envoi reel).
MAIL_MAILER=log
# Le domaine de l'adresse doit etre verifie sur https://resend.com/domains.
# Sans domaine verifie : onboarding@resend.dev, uniquement vers l'email du
# compte Resend.
MAIL_FROM_ADDRESS=noreply@mondomaine.fr
MAIL_FROM_NAME="SAV Ticketing"
# Cle API Resend (https://resend.com/api-keys), uniquement dans .env, jamais commitee.
RESEND_API_KEY=
