DB_HOST=127.0.0.1
DB_PORT=3310
DB_NAME=sav_ticketing
DB_USER=root
DB_PASSWORD=root
APP_ENV=local
APP_URL=http://localhost:8090
# Envoi des emails (memes noms de variables que Laravel) : "log" (dev, ecrit
# dans var/mail.log) ou "resend" (envoi reel).
MAIL_MAILER=log
# onboarding@resend.dev fonctionne sans domaine, mais Resend n'envoie alors
# qu'a l'adresse du compte Resend proprietaire de la cle. Pour ecrire a
# n'importe qui : verifier un domaine sur https://resend.com/domains et
# utiliser une adresse de ce domaine (ex. noreply@mondomaine.fr).
MAIL_FROM_ADDRESS=onboarding@resend.dev
MAIL_FROM_NAME="SAV Ticketing"
# Cle API Resend (https://resend.com/api-keys), uniquement dans .env, jamais commitee.
RESEND_API_KEY=
