{
    "name": "nf31/sav-ticketing-php",
    "description": "Application de gestion de tickets SAV (service apres-vente) en PHP natif, sans framework.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "serve": "php -S localhost:8090 -t public"
    },
    "config": {
        "sort-packages": true
    }
}
